    "yargs": "18.0.0"
  },
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render src/index.ts MyVideo out/video.mp4",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:3d": "remotion render ThreeDAnimation out/ThreeDAnimation.mp4",
    "render:3d:landscape": "remotion render ThreeDAnimationLandscape out/ThreeDAnimationLandscape.mp4",
    "render:gpu": "remotion render ThreeDAnimation out/ThreeDAnimation.mp4 --gl=angle --enable-multiprocess-on-linux",
    "render:map": "remotion render GeoMotion out/GeoMotion.mp4",
    "render:map:cli": "node skills/geomotion-studio/scripts/render.mjs skills/geomotion-studio/examples/neon-cyber-demo.json out/GeoMotion-standalone.mp4",
    "gen": "bun cli/cli.ts"
  },
  "allowScripts": {
    "esbuild": false
  }
}
